{
  "name": "yobachat-server",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "prod:build": "npm run clean && esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js --sourcemap --external:uWebSockets.js --external:tmi.js --external:node-telegram-bot-api --external:ws --external:express --external:youtubei.js --external:jsonwebtoken",
    "dev:build": "npm run clean && esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js --sourcemap --external:uWebSockets.js --external:tmi.js --external:node-telegram-bot-api --external:ws --external:express --external:youtubei.js --external:jsonwebtoken",
    "dev:start": "SERVER_CONFIG_PATH=./server-config.dev.json SHARED_CONFIG_PATH=./shared/shared-config.dev.json node dist/index.js",
    "clean": "rimraf dist",
    "test:youtube-websocket": "tsx test-youtube-websocket.ts"
  },
  "dependencies": {
    "centrifuge": "^5.5.2",
    "chalk": "^5.3.0",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "node-telegram-bot-api": "^0.66.0",
    "reflect-metadata": "^0.2.2",
    "tmi.js": "^1.8.5",
    "tsyringe": "^4.10.0",
    "uWebSockets.js": "github:uNetworking/uWebSockets.js#v20.56.0",
    "ws": "^8.18.3",
    "youtubei.js": "^16.0.1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/gapi.client.youtube": "^3.0.4",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.0",
    "@types/node-telegram-bot-api": "^0.64.12",
    "@types/tmi.js": "^1.8.6",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.27.0",
    "rimraf": "^6.1.2",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "overrides": {
    "form-data": "^4.0.0",
    "tough-cookie": "^4.1.3"
  }
}
