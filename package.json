{
  "name": "yobachat",
  "version": "1.0.0",
  "type": "module",
  "description": "OBS chat widget for Twitch, YouTube, and Telegram",
  "scripts": {
    "postinstall": "node scripts/setup-shared-symlinks.js",
    "install:all": "npm install && cd server && npm install && cd ../client && npm install",

    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",

    "build:server": "cd server && npm run build",
    "build:client": "cd client && npm run build",
    "build:all": "npm run build:server && npm run build:client",

    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop ecosystem.config.js",
    "pm2:restart": "pm2 restart ecosystem.config.js",
    "pm2:delete": "pm2 delete ecosystem.config.js"
  },
  "keywords": ["obs", "chat", "widget", "twitch", "youtube", "telegram"],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "pm2": "^5.3.0",
    "symlink-dir": "^7.0.1",
    "typescript": "^5.3.3"
  }
}
