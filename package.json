{
  "name": "yobachat",
  "version": "1.0.0",
  "type": "module",
  "description": "OBS chat widget for Twitch, YouTube, and Telegram",
  "scripts": {
    "setup": "tsx scripts/setup-dev-config.ts && tsx scripts/setup-shared-symlinks.ts",
    "build": "npm run build:server && npm run build:client",
    "build:server": "rimraf server/dist && cd server && esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js --sourcemap --alias:@shared=../shared --external:uWebSockets.js --external:tmi.js --external:node-telegram-bot-api --external:ws --external:express --external:youtubei.js --external:jsonwebtoken --external:http-proxy-middleware",
    "build:client": "cd client && cross-env CONFIG_PATH=../config.json vite build",
    "prebuild": "tsx scripts/setup-shared-symlinks.ts",
    "dev": "tsx scripts/dev-local.ts",
    "start": "cd server && cross-env NODE_ENV=production CONFIG_PATH=../config.json STORAGE_PATH=../storage node dist/index.js",
    "docker:build": "docker compose -f docker-compose.yml -f docker-compose.build.yml build",
    "docker:up": "docker compose -f docker-compose.yml -f docker-compose.build.yml up -d --build",
    "docker:pull": "docker compose pull",
    "docker:restart": "docker compose up -d --force-recreate",
    "docker:sync": "docker compose pull && docker compose up -d --force-recreate",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "keywords": [
    "obs",
    "chat",
    "widget",
    "twitch",
    "youtube",
    "telegram"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@vueuse/core": "^14.1.0",
    "centrifuge": "^5.5.2",
    "chalk": "^5.3.0",
    "express": "^4.21.2",
    "http-proxy-middleware": "^3.0.5",
    "jsonwebtoken": "^9.0.2",
    "node-telegram-bot-api": "^0.66.0",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "reflect-metadata": "^0.2.2",
    "tmi.js": "^1.8.5",
    "tsyringe": "^4.10.0",
    "uWebSockets.js": "github:uNetworking/uWebSockets.js#v20.56.0",
    "vue": "^3.4.0",
    "vue-router": "^4.6.3",
    "ws": "^8.18.3",
    "youtubei.js": "^17.0.1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/gapi.client.youtube": "^3.0.4",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^24.10.1",
    "@types/node-telegram-bot-api": "^0.64.12",
    "@types/tmi.js": "^1.8.6",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-vue": "^5.0.0",
    "cross-env": "^7.0.3",
    "esbuild": "^0.27.0",
    "rimraf": "^6.1.2",
    "symlink-dir": "^7.0.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vite": "^6.0.0",
    "vite-plugin-checker": "^0.12.0",
    "vue-tsc": "^3.1.5"
  },
  "overrides": {
    "form-data": "^4.0.0",
    "tough-cookie": "^4.1.3"
  }
}
