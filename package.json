{
  "name": "yobachat",
  "version": "1.0.0",
  "type": "module",
  "description": "OBS chat widget for Twitch, YouTube, and Telegram",
  "scripts": {
    "install:all": "npm install && cd server && npm install && cd ../client && npm install",

    "dev:server": "cd server && npm run dev",
    "build:server": "cd server && npm run build",

    "dev:client": "cd client && npm run dev",
    "build:client": "cd client && npm run build",

    "build:all": "npm run build:server && npm run build:client",

    "pm2:start": "pm2 start ecosystem.config.js --only yobachat-server-prod",
    "pm2:stop": "pm2 stop ecosystem.config.js --only yobachat-server-prod",
    "pm2:restart": "pm2 restart ecosystem.config.js --only yobachat-server-prod",
    "pm2:delete": "pm2 delete ecosystem.config.js --only yobachat-server-prod",

    "pm2:start:dev": "pm2 start ecosystem.config.js --only yobachat-server-dev",
    "pm2:stop:dev": "pm2 stop ecosystem.config.js --only yobachat-server-dev",
    "pm2:restart:dev": "pm2 restart ecosystem.config.js --only yobachat-server-dev",
    "pm2:delete:dev": "pm2 delete ecosystem.config.js --only yobachat-server-dev",

    "postinstall": "tsx scripts/setup-shared-symlinks.ts"
  },
  "keywords": [
    "obs",
    "chat",
    "widget",
    "twitch",
    "youtube",
    "telegram"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.10.1",
    "pm2": "^5.3.0",
    "pm2-ecosystem": "^6.0.13",
    "symlink-dir": "^7.0.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
