{
  "name": "yobachat",
  "version": "1.0.0",
  "type": "module",
  "description": "OBS chat widget for Twitch, YouTube, and Telegram",
  "scripts": {
    "install:all": "npm install && cd server && npm install && cd ../client && npm install",

    "--- Production ---": "",
    "prod:build:all": "npm run prod:build:server && npm run prod:build:client",
    "prod:build:server": "cd server && npm run prod:build",
    "prod:build:client": "cd client && npm run prod:build",

    "prod:pm2:start": "pm2 start ecosystem.config.cjs --only yobachat-prod",
    "prod:pm2:stop": "pm2 stop yobachat-prod",
    "prod:pm2:restart": "pm2 restart yobachat-prod --update-env",
    "prod:pm2:delete": "pm2 delete yobachat-prod",
    "prod:pm2:logs": "pm2 logs yobachat-prod --lines 100",

    "--- Development ---": "",
    "dev:build:all": "npm run dev:build:server && npm run dev:build:client",
    "dev:build:server": "cd server && npm run dev:build",
    "dev:build:client": "cd client && npm run dev:build",
    "dev:start:server": "cd server && npm run dev:start",

    "dev:start": "npm run dev:build:all && npm run dev:start:server",
    "dev:pm2:start": "pm2 start ecosystem.config.cjs --only yobachat-dev",
    "dev:pm2:stop": "pm2 stop yobachat-dev",
    "dev:pm2:restart": "pm2 restart yobachat-dev --update-env",
    "dev:pm2:delete": "pm2 delete yobachat-dev",
    "dev:pm2:logs": "pm2 logs yobachat-dev --lines 100"
  },
  "keywords": [
    "obs",
    "chat",
    "widget",
    "twitch",
    "youtube",
    "telegram"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.10.1",
    "pm2": "^6.0.14",
    "pm2-ecosystem": "^6.0.13",
    "symlink-dir": "^7.0.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
