{
  "name": "yobachat",
  "version": "1.0.0",
  "type": "module",
  "description": "OBS chat widget for Twitch, YouTube, and Telegram",
  "scripts": {
    "install:all": "npm install && cd server && npm install && cd ../client && npm install",


    "build:all:prod": "npm run build:server:prod && npm run build:client:prod",

    "build:server:prod": "cd server && npm run build:prod",
    "build:client:prod": "cd client && npm run build:prod",

    "pm2:start:prod": "pm2 start ecosystem.config.cjs --only yobachat-server-prod",
    "pm2:stop:prod": "pm2 stop ecosystem.config.cjs --only yobachat-server-prod",
    "pm2:restart:prod": "pm2 restart ecosystem.config.cjs --only yobachat-server-prod",


    "build:all:dev": "npm run build:server:dev && npm run build:client:dev",

    "build:server:dev": "cd server && npm run build:dev",
    "build:client:dev": "cd client && npm run build:dev",

    "pm2:start:dev": "pm2 start ecosystem.config.cjs --only yobachat-server-dev",
    "pm2:stop:dev": "pm2 stop ecosystem.config.cjs --only yobachat-server-dev",
    "pm2:restart:dev": "pm2 restart ecosystem.config.cjs --only yobachat-server-dev"
  },
  "keywords": [
    "obs",
    "chat",
    "widget",
    "twitch",
    "youtube",
    "telegram"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.10.1",
    "pm2": "^6.0.14",
    "pm2-ecosystem": "^6.0.13",
    "symlink-dir": "^7.0.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
